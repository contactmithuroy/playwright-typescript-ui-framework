# Development environment variables
# Portal paths (relative to BASE_URL). Kept for backward compatibility.
USER_PORTAL_URL=/index.html
ADMIN_PORTAL_URL=/admin/index.html

# Default credentials used by fixtures when running tests locally.
# Update these to valid test accounts for your environment.
USER_PORTAL_USERNAME=username
USER_PORTAL_PASSWORD=password

# Playwright-specific envs used by fixtures and config
# Path to use for fixture auto-login (BasePage.navigateTo uses relative paths)
PLAYWRIGHT_TEST_PATH=/login.html
PLAYWRIGHT_TEST_USERNAME=username
PLAYWRIGHT_TEST_PASSWORD=password

# Base application URL (override if your app runs on a different host)
BASE_URL=http://zero.webappsecurity.com
