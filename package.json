{
  "name": "playwright-typescript-enterprise-framework",
  "version": "2.0.0",
  "description": "Enterprise-grade Playwright TypeScript automation framework with CSV-driven testing",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/smoke/",
    "test:login": "playwright test tests/smoke/verifyLogin.spec.ts",
    "test:transfer": "playwright test tests/smoke/verifyTransferMoney.spec.ts",
    "test:account": "playwright test tests/smoke/verifyAccountSummary.spec.ts",
    "test:chrome": "BROWSERS=chromium playwright test",
    "test:firefox": "BROWSERS=firefox playwright test",
    "test:webkit": "BROWSERS=webkit playwright test",
    "test:mobile": "BROWSERS=mobile-chrome,mobile-safari playwright test",
    "test:all-browsers": "BROWSERS=chromium,firefox,webkit playwright test",
    "test:dev": "TEST_ENV=development playwright test",
    "test:staging": "TEST_ENV=staging playwright test",
    "test:prod": "TEST_ENV=production playwright test",
    "test:parallel": "playwright test --workers=4",
    "test:sequential": "playwright test --workers=1",
    "report": "playwright show-report",
    "report:open": "playwright show-report --port 9323",
    "report:allure": "allure generate allure-results --clean && allure open",
    "codegen": "playwright codegen",
    "codegen:url": "playwright codegen http://zero.webappsecurity.com",
    "trace": "playwright show-trace",
    "clean": "rm -rf test-results playwright-report allure-results screenshots .auth",
    "clean:cache": "rm -rf node_modules/.cache",
    "clean:all": "npm run clean && npm run clean:cache",
    "install:browsers": "playwright install",
    "install:deps": "playwright install-deps",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "pretest": "npm run clean",
    "posttest": "npm run report",
    "ci": "npm run test -- --reporter=html,junit",
    "ci:smoke": "npm run test:smoke -- --reporter=html,junit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "e2e",
    "csv-driven",
    "data-driven",
    "enterprise",
    "framework"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^2.15.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
